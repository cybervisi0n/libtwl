#
#  Nitro LCF SPEC FILE
#

Static $(TARGET_NAME)
{
	Address		0x02380000
	Library		crt0.o
	StackSize	1024 512
}

#Objects on MAIN RAM	# nothing for elf2bin
#Autoload MAIN
#{
#	Address		0x027e0000
#	Library		
#}

Autoload WRAM
{
	Address		0x037f8000
	Object		$(OBJS_STATIC)
	Library		$(LLIBS) $(GLIBS) $(CW_LIBS)
	Object		* (.wram)
	Object		* (.main)
}
